<Page Name="Window"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:componentmodel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <CollectionViewSource x:Key="CvsEditors">
            <CollectionViewSource.SortDescriptions>
                <componentmodel:SortDescription Direction="Ascending"
                                                PropertyName="Name" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <CollectionViewSource x:Key="CvsModules">
            <CollectionViewSource.SortDescriptions>
                <componentmodel:SortDescription Direction="Ascending"
                                                PropertyName="Name" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <CollectionViewSource x:Key="CvsQuickAccessWordList">
            <CollectionViewSource.SortDescriptions>
                <componentmodel:SortDescription Direction="Ascending"
                                                PropertyName="Name" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <sys:String x:Key="StrModuleOpenPath">x</sys:String>
        <sys:String x:Key="StrModuleOpenRead">x</sys:String>
        <sys:String x:Key="ValueTtDescription">x</sys:String>
        <sys:String x:Key="ValueTtVersion">x</sys:String>
        <sys:String x:Key="ValueTtPath">x</sys:String>
        <sys:String x:Key="Version">x</sys:String>
        <Thickness x:Key="StdMargin">5</Thickness>

        <CompositeCollection x:Key="CcEditors">
            <CollectionContainer Collection="{Binding Source={StaticResource CvsEditors}}" />
        </CompositeCollection>

        <Style TargetType="Button"
               x:Key="BtnBaseStyle">
            <Setter Property="Margin"
                    Value="{StaticResource StdMargin}" />
        </Style>
        <Style TargetType="Button"
               x:Key="BtnOpenModuleStyle"
               BasedOn="{StaticResource BtnBaseStyle}">
            <Setter Property="IsEnabled"
                    Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=LbModules, Path=SelectedItems.Count}"
                             Value="0">
                    <Setter Property="IsEnabled"
                            Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox"
               x:Key="ChbBaseStyle">
            <Setter Property="Margin"
                    Value="{StaticResource StdMargin}" />
            <Setter Property="IsThreeState"
                    Value="False" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
        </Style>
        <Style TargetType="Grid"
               x:Key="GrBaseStyle">
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
            <Setter Property="Margin"
                    Value="0" />
        </Style>
        <Style TargetType="MenuItem"
               x:Key="MiReadStyle">
            <EventSetter Event="Click" />
            <Setter Property="Header"
                    Value="{Binding Path=Name}" />
        </Style>
        <Style TargetType="ScrollViewer"
               x:Key="SvDefaultStyle">
            <Setter Property="Grid.Column"
                    Value="1" />
            <Setter Property="Margin"
                    Value="{StaticResource StdMargin}" />
            <Setter Property="VerticalScrollBarVisibility"
                    Value="Auto" />
        </Style>
        <Style TargetType="TextBlock"
               x:Key="TblBaseStyle">
            <Setter Property="Margin"
                    Value="{StaticResource StdMargin}" />
        </Style>
        <Style TargetType="TextBlock"
               x:Key="TblExpCmdStyle"
               BasedOn="{StaticResource TblBaseStyle}">
            <EventSetter Event="Mouse.MouseEnter" />
            <EventSetter Event="Mouse.MouseLeave" />
        </Style>
        <Style TargetType="TextBlock"
               x:Key="TblSmallTitleStyle"
               BasedOn="{StaticResource TblBaseStyle}">
            <Setter Property="FontSize"
                    Value="16" />
            <Setter Property="FontWeight"
                    Value="Bold" />
        </Style>
        <Style TargetType="TextBlock"
               x:Key="TblTitleStyle"
               BasedOn="{StaticResource TblBaseStyle}">
            <Setter Property="FontSize"
                    Value="20" />
            <Setter Property="FontWeight"
                    Value="Bold" />
        </Style>
        <Style TargetType="TextBlock"
               x:Key="TblValueStyle"
               BasedOn="{StaticResource TblBaseStyle}">
        </Style>
    </Page.Resources>
    <TabControl>
        <TabItem Name="TiInfo">
            <TabItem.Header>
                <TextBlock Style="{StaticResource TblTitleStyle}"
                           Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTiInfoHeader}" />
            </TabItem.Header>
            <Grid Name="GridInfo"
                  Style="{StaticResource GrBaseStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <TextBlock Name="TblVersionTitle"
                           Style="{StaticResource TblTitleStyle}"
                           Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblVersionTitle}" />
                <TextBlock Name="TblVersion"
                           Grid.Column="1"
                           Style="{StaticResource TblValueStyle}"
                           Text="{DynamicResource Version}" />
                <TextBlock Name="TblPSVersionTableTitle"
                           Grid.Row="1"
                           Style="{StaticResource TblTitleStyle}"
                           Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblPSVersionTableTitle}" />
                <TextBlock Name="TblPSVersionTable"
                           Grid.Column="1"
                           Grid.Row="1"
                           Style="{StaticResource TblValueStyle}" />
                <TextBlock Name="TblO365AccountTitle"
                           Grid.Row="2"
                           Style="{StaticResource TblTitleStyle}"
                           Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblO365AccountTitle}" />
                <TextBlock Name="TblO365Account"
                           Grid.Column="1"
                           Grid.Row="2"
                           Style="{StaticResource TblValueStyle}" />
                <TextBlock Name="TblModulesTitle"
                           Grid.Row="3"
                           Style="{StaticResource TblTitleStyle}"
                           Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblModulesTitle}" />
                <Grid Grid.Row="3"
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      Margin="{StaticResource StdMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <ListBox Name="LbModules"
                             DisplayMemberPath="Name"
                             ItemsSource="{Binding Source={StaticResource CvsModules}}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <Grid DataContext="{Binding ElementName=LbModules, Path=SelectedItem}"
                          Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource TblSmallTitleStyle}"
                                   Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblValueTtOpen}" />
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button Name="BtnOpenModuleFolder"
                                    Content="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentBtnOpenFolder}"
                                    Style="{StaticResource BtnOpenModuleStyle}" />
                            <Button Name="BtnOpenFile"
                                    Content="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentBtnOpenFile}"
                                    Grid.Column="1"
                                    Style="{StaticResource BtnOpenModuleStyle}">
                                <Button.ContextMenu>
                                    <ContextMenu ItemsSource="{StaticResource CcEditors}">
                                        <ContextMenu.Resources>
                                            <Style TargetType="MenuItem"
                                                   BasedOn="{StaticResource MiReadStyle}" />
                                        </ContextMenu.Resources>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource TblSmallTitleStyle}"
                                   Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblValueTtVersion}" />
                        <TextBlock Grid.Column="1"
                                   Grid.Row="1"
                                   Style="{StaticResource TblValueStyle}"
                                   Text="{Binding Path=Version}" />
                        <TextBlock Grid.Row="2"
                                   Style="{StaticResource TblSmallTitleStyle}"
                                   Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblValueTtDescription}" />
                        <TextBlock Grid.Column="1"
                                   Grid.Row="2"
                                   Style="{StaticResource TblValueStyle}"
                                   Text="{Binding Path=Description}"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="3"
                                   Style="{StaticResource TblSmallTitleStyle}"
                                   Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblValueTtPath}" />
                        <TextBlock Grid.Column="1"
                                   Grid.Row="3"
                                   Style="{StaticResource TblValueStyle}"
                                   Text="{Binding Path=Path}"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="4"
                                   Style="{StaticResource TblSmallTitleStyle}"
                                   Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblValueTtExportedCommands}" />
                        <Grid Grid.Column="1"
                              Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl Name="IcExportedCommands"
                                              ItemsSource="{Binding Path=ExportedCommands}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=Key}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource TblExpCmdStyle}">
                                                        <Setter Property="Margin"
                                                                Value="0" />
                                                        <Setter Property="Padding"
                                                                Value="5" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}"
                                                                         Value="True">
                                                                <Setter Property="Background"
                                                                        Value="#FFDCF1F7" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Name="TblExpCmdInfo"
                                       Grid.Column="1"
                                       Margin="{StaticResource StdMargin}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Grid>
                </Grid>
                <TextBlock Name="TblQuickAccessTitle"
                           Grid.Row="4"
                           Style="{StaticResource TblTitleStyle}"
                           Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblQuickAccessTitle}"
                           ToolTip="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblQuickAccessTitleTt}" />
                <ScrollViewer Name="SvQuickAccess"
                              Grid.Row="4"
                              Style="{StaticResource SvDefaultStyle}">
                    <ItemsControl Name="IcQuickAccess"
                                  ItemsSource="{Binding Source={StaticResource CvsQuickAccessWordList}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Background"
                                                    Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}"
                                                             Value="True">
                                                    <Setter Property="Background"
                                                            Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="16"
                                               FontWeight="Bold"
                                               Margin="{StaticResource StdMargin}"
                                               Text="{Binding Path=Key}"
                                               VerticalAlignment="Top" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition MinWidth="150"
                                                              Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="0"
                                                   Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentQATitleName}" />
                                        <TextBlock Grid.Column="1"
                                                   Grid.Row="0"
                                                   Text="{Binding Path=Value.Name}" />
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="1"
                                                   Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentQATitleDesc}" />
                                        <TextBlock Grid.Column="1"
                                                   Grid.Row="1"
                                                   Text="{Binding Path=Value.Description}" />
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="2"
                                                   Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentQATitleMi}" />
                                        <TextBlock Grid.Column="1"
                                                   Grid.Row="2"
                                                   Text="{Binding Path=Value.MenuItem}" />
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="3"
                                                   Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentQATitleSeparate}" />
                                        <TextBlock Grid.Column="1"
                                                   Grid.Row="3"
                                                   Text="{Binding Path=Value.Separate, FallbackValue='False'}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <TabItem Name="TiSettings">
            <TabItem.Header>
                <TextBlock Style="{StaticResource TblTitleStyle}"
                           Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTiSettingsHeader}" />
            </TabItem.Header>
            <Grid Name="GridSettings"
                  Style="{StaticResource GrBaseStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Name="TblSuiteSettingsInfo"
                           FontWeight="Normal"
                           Grid.ColumnSpan="2"
                           Style="{StaticResource TblTitleStyle}"
                           Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblSuiteSettingsInfo}" />
                <TextBlock Name="TblRunOnLoginTitle"
                           Grid.Row="1"
                           Style="{StaticResource TblTitleStyle}"
                           Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblRunOnLoginTitle}" />
                <CheckBox Name="ChbRunOnLogin"
                          Content="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentChbRunOnLogin}"
                          Grid.Column="1"
                          Grid.Row="1"
                          Style="{StaticResource ChbBaseStyle}" />
            </Grid>
        </TabItem>
    </TabControl>
</Page>
