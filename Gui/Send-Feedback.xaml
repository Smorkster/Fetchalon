<Page Name="Window"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:componentmodel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <CollectionViewSource x:Key="CvsHierarchicalFunctions">
            <CollectionViewSource.SortDescriptions>
                <componentmodel:SortDescription Direction="Ascending"
                                                PropertyName="MenuItem" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <CollectionViewSource x:Key="CvsHierarchicalPropHandlers">
            <CollectionViewSource.SortDescriptions>
                <componentmodel:SortDescription Direction="Ascending"
                                                PropertyName="MenuItem" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>

        <Thickness x:Key="StdMargin">5</Thickness>

        <Style TargetType="Border"
               x:Key="BrdGroupStyle">
            <Setter Property="BorderThickness"
                    Value="4,0,0,0" />
            <Setter Property="Margin"
                    Value="2,5" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize"
                    Value="15" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="IsEnabled"
                    Value="True" />
            <Setter Property="Margin"
                    Value="{StaticResource StdMargin}" />
            <Setter Property="MinHeight"
                    Value="45" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=TbText, Path=Text.Length}"
                             Value="0">
                    <Setter Property="IsEnabled"
                            Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox"
               x:Key="ChbDefaultStyle">
            <Setter Property="Margin"
                    Value="{StaticResource StdMargin}" />
        </Style>

        <Style TargetType="Label"
               x:Key="LblDefaultStyle">
            <Setter Property="FontSize"
                    Value="15" />
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="Margin"
                    Value="{StaticResource StdMargin}" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
        </Style>

        <Style TargetType="TextBlock"
               x:Key="TblBaseStyle">
            <Setter Property="FontSize"
                    Value="15" />
            <Setter Property="Margin"
                    Value="{StaticResource StdMargin}" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
        <Style TargetType="TextBlock"
               x:Key="TblTitleStyle"
               BasedOn="{StaticResource TblBaseStyle}">
            <Setter Property="FontWeight"
                    Value="Bold" />
        </Style>

        <Style TargetType="TextBox"
               x:Key="TbDefaultStyle">
            <Setter Property="AcceptsReturn"
                    Value="True" />
            <Setter Property="Margin"
                    Value="{StaticResource StdMargin}" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
        </Style>

        <HierarchicalDataTemplate x:Key="Hdt"
                                  ItemsSource="{Binding Path=Items}">
            <ContentControl IsTabStop="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock FontSize="14"
                                               Text="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=DataContext.MenuItem}"
                                               ToolTip="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=DataContext.Synopsis}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource TblBaseStyle}">
                                                <Setter Property="FontWeight"
                                                        Value="Normal" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="FontWeight"
                                                                Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </HierarchicalDataTemplate>

        <Style TargetType="TreeView"
               x:Key="TvDefaultStyle">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                 Color="Transparent" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                 Color="#FF444444" />
            </Style.Resources>
            <Setter Property="Background"
                    Value="White" />
            <Setter Property="Grid.Row"
                    Value="1" />
            <Setter Property="ItemTemplate"
                    Value="{StaticResource Hdt}" />
            <Setter Property="Margin"
                    Value="{StaticResource StdMargin}" />
            <Setter Property="MaxHeight"
                    Value="180" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=TBtnSuggestion, Path=IsChecked}"
                             Value="True">
                    <Setter Property="Selector.SelectedIndex"
                            Value="-1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsKeyboardFocusWithin}"
                             Value="False">
                    <Setter Property="Background"
                            Value="WhiteSmoke" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border BorderBrush="Gray">
            <Border.Style>
                <Style TargetType="Border"
                       BasedOn="{StaticResource BrdGroupStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=ExpSuggestion, Path=IsExpanded}"
                                     Value="True">
                            <Setter Property="BorderThickness"
                                    Value="4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Expander Name="ExpSuggestion"
                      Grid.Row="0">
                <Expander.Header>
                    <TextBlock Name="TblSuggestionExpanderTitle"
                               Style="{StaticResource TblTitleStyle}"
                               Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblSuggestionExpanderTitle}" />
                </Expander.Header>
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Name="TblSuggestionTitle"
                               Style="{StaticResource TblTitleStyle}"
                               Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblSuggestionTitle}" />
                    <ToggleButton Name="TBtnSuggestion"
                                  Content="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTBtnSuggestion}"
                                  FontSize="15"
                                  FontWeight="Bold"
                                  Grid.Row="1"
                                  Margin="{StaticResource StdMargin}"
                                  MinHeight="45" />
                </Grid>
            </Expander>
        </Border>
        <Border BorderBrush="Gold"
                Grid.Row="1">
            <Border.Style>
                <Style TargetType="Border"
                       BasedOn="{StaticResource BrdGroupStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=ExpScript, Path=IsExpanded}"
                                     Value="True">
                            <Setter Property="BorderThickness"
                                    Value="4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Expander Name="ExpScript"
                      Grid.Row="1">
                <Expander.Header>
                    <TextBlock Name="TblScriptExpanderTitle"
                               Style="{StaticResource TblTitleStyle}"
                               Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblScriptExpanderTitle}" />
                </Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition MaxHeight="200" />
                    </Grid.RowDefinitions>
                    <TextBlock Name="TblScriptTitle"
                               Style="{StaticResource TblTitleStyle}"
                               Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblScriptTitle}" />
                    <TreeView Name="TvMenuList"
                              ItemsSource="{Binding Source={StaticResource CvsHierarchicalFunctions}}"
                              Style="{StaticResource TvDefaultStyle}" />
                </Grid>
            </Expander>
        </Border>
        <Border BorderBrush="LightBlue"
                Grid.Row="2">
            <Border.Style>
                <Style TargetType="Border"
                       BasedOn="{StaticResource BrdGroupStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=ExpPropHandler, Path=IsExpanded}"
                                     Value="True">
                            <Setter Property="BorderThickness"
                                    Value="4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Expander Name="ExpPropHandler"
                      Grid.Row="2">
                <Expander.Header>
                    <TextBlock Name="TblPropHandlerExpanderTitle"
                               Style="{StaticResource TblTitleStyle}"
                               Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblPropHandlerExpanderTitle}" />
                </Expander.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Name="TblPropHandlerTitle"
                               Style="{StaticResource TblTitleStyle}"
                               Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblPropHandlerTitle}" />
                    <TreeView Name="TvPropHandlerList"
                              ItemsSource="{Binding Source={StaticResource CvsHierarchicalPropHandlers}}"
                              Style="{StaticResource TvDefaultStyle}" />
                </Grid>
            </Expander>
        </Border>
        <Border BorderBrush="MediumSeaGreen"
                Grid.Row="3">
            <Border.Style>
                <Style TargetType="Border"
                       BasedOn="{StaticResource BrdGroupStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=TbText, Path=IsKeyboardFocused}"
                                     Value="True">
                            <Setter Property="BorderThickness"
                                    Value="2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Label Name="LblDescTitle"
                       Content="{Binding ElementName=Window, Path=DataContext.MsgTable.StrDescTitle}"
                       Style="{StaticResource LblDefaultStyle}" />
                <TextBlock Name="TblDescription"
                           Grid.Column="1"
                           Style="{StaticResource TblBaseStyle}" />
                <Label Name="LblAuthorTitle"
                       Content="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentLblAuthorTitle}"
                       Grid.Row="1">
                    <Label.Style>
                        <Style TargetType="Label"
                               BasedOn="{StaticResource LblDefaultStyle}">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=TBtnSuggestion, Path=IsChecked}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Label.Style>
                </Label>
                <TextBlock Name="TblAuthor"
                           Grid.Column="1"
                           Grid.Row="1"
                           Style="{StaticResource TblBaseStyle}" />
            </Grid>
        </Border>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <CheckBox Name="ChbIncludeErrorMsgs"
                      Content="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTblIncludeErrorMsgsTitle}"
                      FontSize="15"
                      FontWeight="Bold"
                      IsChecked="False"
                      Style="{StaticResource ChbDefaultStyle}"
                      VerticalContentAlignment="Center" />
            <Grid Grid.ColumnSpan="2"
                  Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width"
                                        Value="1*" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=ChbIncludeErrorMsgs, Path=IsChecked}"
                                                 Value="False">
                                        <Setter Property="Width"
                                                Value="Auto" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource TblBaseStyle}"
                           Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentTextTitle}" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource TblBaseStyle}"
                           Text="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentErrorMsgsTitle}"
                           Visibility="{Binding ElementName=TbErrorMsgs, Path=Visibility}" />
                <TextBox Name="TbText"
                         Grid.Row="1"
                         Style="{StaticResource TbDefaultStyle}" />
                <TextBox Name="TbErrorMsgs"
                         Grid.Column="1"
                         Grid.Row="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox"
                               BasedOn="{StaticResource TbDefaultStyle}">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=ChbIncludeErrorMsgs, Path=IsChecked}"
                                             Value="False">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </Grid>
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Name="BtnSendReport"
                    Content="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentBtnSendReport}" />
            <Button Name="BtnAbortReport"
                    Content="{Binding ElementName=Window, Path=DataContext.MsgTable.ContentBtnAbortReport}"
                    Grid.Column="1" />
        </Grid>
    </Grid>
</Page>
